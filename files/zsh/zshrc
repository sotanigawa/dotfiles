# -*- mode: sh -*-

mkdir -p ~/.cache/zsh ~/.local/state/zsh

# History
HISTFILE=~/.local/state/zsh/history
HISTSIZE=100000
SAVEHIST=100000

# Options
setopt auto_cd auto_pushd pushd_ignore_dups
setopt extended_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks share_history
setopt interactive_comments

# Prompt
PROMPT='[%F{green}%~%f]%# '
RPROMPT='%(?..%F{red}[%?]%f)'

# Completion
autoload -Uz compinit
compinit -d ~/.cache/zsh/compdump
zstyle ':completion:*' matcher-list 'm:{[:lower:]}={[:upper:]}' '+l:|=* r:|=*'

# Key bindings
bindkey -e

# Aliases
alias ls='eza'
alias grep='grep --color=auto'
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'
alias sudo='sudo '
alias mkdir='mkdir -p'
alias vim='nvim'
alias copy='xclip -selection clipboard'
alias unoconv='libreoffice --headless --convert-to pdf'

# Fuzzy finder (fzf)
source <(fzf --zsh)
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --bind=ctrl-k:kill-line'
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"
export FZF_CTRL_T_COMMAND='fd --type f --hidden --exclude .git'

# Directory jumping (zoxide)
eval "$(zoxide init zsh --cmd cd)"
